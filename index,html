<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CINEREX — Premium Cinema</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --bg: #070708;
      --panel: #111114;
      --text: #f5f5f5;
      --muted: #99999f;
      --accent: #e50914;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: Inter, Arial, sans-serif;
      overflow-x: hidden;
    }

    button,
    input {
      font: inherit;
    }

    /* NAVBAR */

    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 76px;
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 5%;
      background: linear-gradient(
        to bottom,
        rgba(0,0,0,.95),
        rgba(0,0,0,.35),
        transparent
      );
      transition: .3s;
    }

    .logo {
      font-size: 25px;
      font-weight: 900;
      letter-spacing: -1px;
    }

    .logo span {
      color: var(--accent);
    }

    .nav-links {
      display: flex;
      gap: 28px;
      margin-left: 35px;
      flex: 1;
    }

    .nav-links a {
      color: #d5d5d5;
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
      transition: .25s;
    }

    .nav-links a:hover {
      color: white;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .search {
      width: 210px;
      height: 38px;
      padding: 0 15px;
      border: 1px solid #333338;
      outline: none;
      border-radius: 8px;
      background: rgba(20,20,23,.85);
      color: white;
    }

    .profile {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: linear-gradient(135deg,#e50914,#74101a);
      display: grid;
      place-items: center;
      font-weight: 800;
    }

    /* HERO */

    .hero {
      height: 720px;
      min-height: 680px;
      position: relative;
      display: flex;
      align-items: center;
      padding: 0 7%;
      overflow: hidden;
      background:
        linear-gradient(
          90deg,
          rgba(0,0,0,.95) 0%,
          rgba(0,0,0,.72) 38%,
          rgba(0,0,0,.15) 75%,
          rgba(0,0,0,.85) 100%
        ),
        linear-gradient(
          0deg,
          #070708 0%,
          transparent 30%
        ),
        url("https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=2200&q=90")
        center/cover;
    }

    .hero-content {
      max-width: 650px;
      padding-top: 80px;
    }

    .eyebrow {
      display: inline-flex;
      gap: 8px;
      align-items: center;
      margin-bottom: 20px;
      color: #ddd;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent);
    }

    .hero h1 {
      font-size: clamp(48px, 7vw, 90px);
      line-height: .9;
      letter-spacing: -5px;
      font-weight: 900;
      margin-bottom: 25px;
    }

    .hero h1 span {
      color: var(--accent);
    }

    .meta {
      display: flex;
      gap: 18px;
      color: #ddd;
      margin-bottom: 20px;
      font-size: 14px;
      font-weight: 600;
    }

    .description {
      color: #c5c5c8;
      line-height: 1.7;
      max-width: 570px;
      font-size: 15px;
      margin-bottom: 30px;
    }

    .actions {
      display: flex;
      gap: 12px;
    }

    .btn {
      border: 0;
      padding: 13px 22px;
      border-radius: 7px;
      cursor: pointer;
      font-weight: 800;
      transition: .25s;
    }

    .btn-primary {
      background: white;
      color: black;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      background: #e9e9e9;
    }

    .btn-secondary {
      background: rgba(80,80,85,.65);
      color: white;
      backdrop-filter: blur(10px);
    }

    .btn-secondary:hover {
      background: rgba(110,110,115,.75);
    }

    /* CONTENT */

    main {
      position: relative;
      margin-top: -100px;
      z-index: 5;
    }

    .section {
      padding: 0 5% 50px;
    }

    .section-title {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 18px;
    }

    .section-title h2 {
      font-size: 23px;
      letter-spacing: -.7px;
    }

    .section-title a {
      color: #aaa;
      text-decoration: none;
      font-size: 13px;
    }

    .movies {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 15px;
    }

    .movie {
      position: relative;
      aspect-ratio: 2 / 3;
      border-radius: 8px;
      overflow: hidden;
      background: #151519;
      cursor: pointer;
      transition:
        transform .3s,
        box-shadow .3s;
    }

    .movie:hover {
      transform: scale(1.045);
      z-index: 10;
      box-shadow: 0 18px 50px rgba(0,0,0,.65);
    }

    .movie img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .movie-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 14px;
      background:
        linear-gradient(
          to top,
          rgba(0,0,0,.95),
          rgba(0,0,0,.15) 55%,
          transparent
        );
    }

    .movie-title {
      font-size: 14px;
      font-weight: 800;
      margin-bottom: 5px;
    }

    .movie-info {
      font-size: 11px;
      color: #bbb;
    }

    .rating {
      color: #ffd84d;
    }

    /* GENRES */

    .genres {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      padding-bottom: 10px;
    }

    .genre {
      flex: 0 0 auto;
      padding: 11px 17px;
      border: 1px solid #28282d;
      background: #101013;
      border-radius: 100px;
      color: #ccc;
      font-size: 13px;
      cursor: pointer;
      transition: .2s;
    }

    .genre:hover {
      background: #1c1c20;
      color: white;
      border-color: #444;
    }

    /* FOOTER */

    footer {
      border-top: 1px solid #18181c;
      margin-top: 40px;
      padding: 45px 5%;
      color: #777;
      font-size: 13px;
      display: flex;
      justify-content: space-between;
    }

    footer strong {
      color: #ddd;
    }

    /* RESPONSIVE */

    @media (max-width: 1100px) {
      .movies {
        grid-template-columns: repeat(4, 1fr);
      }

      .nav-links {
        display: none;
      }
    }

    @media (max-width: 700px) {
      .navbar {
        padding: 0 20px;
      }

      .search {
        width: 130px;
      }

      .hero {
        height: 650px;
        min-height: 650px;
        padding: 0 25px;
      }

      .hero h1 {
        letter-spacing: -3px;
      }

      .movies {
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
      }

      .section {
        padding-left: 20px;
        padding-right: 20px;
      }

      footer {
        flex-direction: column;
        gap: 15px;
      }
    }
  </style>
</head>

