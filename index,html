  <script>
    function playMovie() {
      alert("Player will open here when a licensed/public-domain video is connected.");
    }

    function addToList() {
      alert("Added to My List.");
    }

    const search = document.getElementById("search");
    const movies = document.querySelectorAll(".movie");

    search.addEventListener("input", () => {
      const query = search.value.toLowerCase().trim();

      movies.forEach(movie => {
        const title = movie.dataset.title?.toLowerCase() || "";
        movie.style.display =
          title.includes(query) ? "block" : "none";
      });
    });

    window.addEventListener("scroll", () => {
      const nav = document.querySelector(".navbar");

      if (window.scrollY > 50) {
        nav.style.background = "rgba(7,7,8,.94)";
        nav.style.backdropFilter = "blur(16px)";
      } else {
        nav.style.background =
          "linear-gradient(to bottom, rgba(0,0,0,.95), rgba(0,0,0,.35), transparent)";
        nav.style.backdropFilter = "none";
      }
    });
  </script>

